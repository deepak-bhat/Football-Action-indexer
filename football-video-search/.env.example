# ── Azure OpenAI ──────────────────────────────────────────────────────────────
# Found in: Azure Portal → your OpenAI resource → Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-key-here>

# API version — use 2024-02-01 or later
AZURE_OPENAI_API_VERSION=2024-02-01

# Deployment names — must match what you created in Azure OpenAI Studio
# Chat model (GPT-4o recommended; GPT-4-turbo also works)
AZURE_CHAT_DEPLOYMENT=gpt-4o
# Embedding model (text-embedding-3-small or text-embedding-ada-002)
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ── Optional overrides (defaults shown) ───────────────────────────────────────
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cpu

# Qdrant storage — two modes (pick one):
# 1. Embedded (no Docker needed) — leave QDRANT_HOST empty, set QDRANT_PATH
QDRANT_PATH=data/qdrant
QDRANT_HOST=
# 2. Remote server (Docker or standalone binary) — set QDRANT_HOST
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

SQLITE_DB_PATH=data/football.db
VIDEO_BASE_DIR=videos
DEFAULT_TOP_K=20
